          "source_pdf_sha256": "456181c690f95116b2edc2cef0edadd0f48fa1eb4f9037e3a08870ad5b34626c",
          "section_anchor": "2.6 Sexualerziehung",
          "printed_page": 47,
          "physical_page": 47
        },
        "cited_text": "Die schulische Sexualerziehung unterstützt Jugendliche und junge Erwachsene",
