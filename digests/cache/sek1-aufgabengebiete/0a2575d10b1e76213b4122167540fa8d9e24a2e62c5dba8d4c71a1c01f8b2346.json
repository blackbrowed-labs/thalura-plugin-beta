  "digest": {
    "claims": [
      {
        "content": "Berufsorientierung (2.1): the aim of career orientation is to strengthen students' individual career-choice competence (Berufswahlkompetenz).",
        "citation": {
          "document_id": "sek1-aufgabengebiete",
          "document_title": "Bildungsplan Gymnasium Sekundarstufe I — Aufgabengebiete",
          "source_pdf_sha256": "28cea45c8bb20f001453d0b5f32ed130011aef08c538e4559cbe7a8333215966",
          "section_anchor": "2 Kompetenzen und Inhalte in den Aufgabengebieten",
          "printed_page": 8,
          "physical_page": 8
        },
        "cited_text": "Ziel der beruflichen Orientierung ist es, die individuelle Berufswahlkompetenz",
        "residual_flags": []
      },
      {
        "content": "Globales Lernen (2.3) is an essential part of education for sustainable development (BNE) and addresses the existential challenges that make a transformation of our whole way of living and doing business necessary.",
        "citation": {
          "document_id": "sek1-aufgabengebiete",
          "document_title": "Bildungsplan Gymnasium Sekundarstufe I — Aufgabengebiete",
          "source_pdf_sha256": "28cea45c8bb20f001453d0b5f32ed130011aef08c538e4559cbe7a8333215966",
          "section_anchor": "2 Kompetenzen und Inhalte in den Aufgabengebieten",
          "printed_page": 22,
          "physical_page": 22
        },
        "cited_text": "Globales Lernen ist wesentlicher Teil einer Bildung für nachhaltige Entwicklung (BNE) und \nsetzt sich mit den existenziellen Herausforderungen auseinander, die eine Transformation un-\nserer gesamten Lebens- und Wirtschaftsweise notwendig machen",
        "residual_flags": []
      },
      {
        "content": "Medienerziehung (2.5) aims to prepare students appropriately for life in current and future society.",
        "citation": {
          "document_id": "sek1-aufgabengebiete",
          "document_title": "Bildungsplan Gymnasium Sekundarstufe I — Aufgabengebiete",
          "source_pdf_sha256": "28cea45c8bb20f001453d0b5f32ed130011aef08c538e4559cbe7a8333215966",
          "section_anchor": "2 Kompetenzen und Inhalte in den Aufgabengebieten",
          "printed_page": 39,
          "physical_page": 39
        },
        "cited_text": "Medienerziehung hat zum Ziel, Schülerinnen und Schüler angemessen auf das Leben in der \nderzeitigen und künftigen Gesellschaft vorzubereiten",
        "residual_flags": []
      },
      {
        "content": "Sexualerziehung (2.6) is a task of both home and school; in secondary it builds on and complements sex education in the home and primary school.",
        "citation": {
          "document_id": "sek1-aufgabengebiete",
          "document_title": "Bildungsplan Gymnasium Sekundarstufe I — Aufgabengebiete",
          "source_pdf_sha256": "28cea45c8bb20f001453d0b5f32ed130011aef08c538e4559cbe7a8333215966",
          "section_anchor": "2 Kompetenzen und Inhalte in den Aufgabengebieten",
          "printed_page": 47,
          "physical_page": 47
        },
        "cited_text": "Sexualerziehung ist eine Aufgabe von Elternhaus und Schule. Sexualerziehung in der Sekun-\ndarstufe knüpft an die Sexualerziehung in Elternhaus und Grundschule an und ergänzt diese",
        "residual_flags": []
      },
      {
        "content": "Umwelterziehung (2.8) is part of education for sustainable development (BNE) and aims to develop in young people a sense of responsibility for nature and the environment.",
        "citation": {
          "document_id": "sek1-aufgabengebiete",
          "document_title": "Bildungsplan Gymnasium Sekundarstufe I — Aufgabengebiete",
          "source_pdf_sha256": "28cea45c8bb20f001453d0b5f32ed130011aef08c538e4559cbe7a8333215966",
          "section_anchor": "2 Kompetenzen und Inhalte in den Aufgabengebieten",
          "printed_page": 61,
          "physical_page": 61
        },
        "cited_text": "Die Umwelterziehung ist Teil der Bildung für nachhaltige Entwicklung (BNE) und zielt darauf, bei \nJugendlichen und jungen Erwachsenen ein Verantwortungsbewusstsein für Natur und Umwelt",
        "residual_flags": []
      },
      {
        "content": "Der Themenbereich Zukunftsfähige Mobilität ist Teil der behandelten Aufgabengebiete.",
        "citation": {
          "document_id": "sek1-aufgabengebiete",
