          "source_pdf_sha256": "28cea45c8bb20f001453d0b5f32ed130011aef08c538e4559cbe7a8333215966",
          "section_anchor": "2 Kompetenzen und Inhalte in den Aufgabengebieten",
          "printed_page": 74,
