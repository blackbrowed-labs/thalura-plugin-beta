  "digest": {
    "claims": [
      {
        "content": "The core curriculum uses at most half the available time, leaving room for individual deepening and priorities depending on course profile and time.",
        "citation": {
          "document_id": "bildungsplan-sek2-psychology",
          "document_title": "Bildungsplan Studienstufe Psychologie",
