        },
        "cited_text": "Arten von Stress (akut/chronisch, Eustress/Disstress)",
        "residual_flags": []
      },
      {
        "content": "Stressors are classified as physiological, social, economic/ecological and occupational.",
        "citation": {
          "document_id": "bildungsplan-sek2-psychology",
          "document_title": "Bildungsplan Studienstufe Psychologie",
